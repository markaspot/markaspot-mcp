# GeoReport MCP Gateway - shared marketplace endpoint (mcp.mark-a-spot.com).
#
# One bridge instance serving MULTIPLE tenants behind a single public URL, for
# marketplaces that pin one URL per integration (e.g. Ayunis Core). Data
# separation is enforced by the dispatch, not by topology: every Bearer token in
# MCP_AUTH_USERS is pinned to exactly one tenant (and optionally to
# jurisdictions), so a token can never reach another customer's backend.
#
# Copy to /opt/markaspot-cloud/tenants/gateway.mcp.env on cp1 (chmod 600, never
# commit). Runs on the SAME compose file as the per-tenant bridges:
#   docker compose --env-file tenants/gateway.mcp.env -p gateway-mcp \
#     -f deploy/docker-compose.mcp.yml up -d
#
# Onboard new tenants with deploy/mcp-add-tenant.sh instead of hand-editing the
# JSON lines below. See deploy/GATEWAY.md for the full runbook.

NODE_ENV=production
MCP_SERVER_PORT=3100
LOG_LEVEL=info

# --- Per-stack routing (consumed by docker-compose.mcp.yml, NOT by the app) ---
MCP_PROJECT=gateway-mcp
MCP_PUBLIC_HOST=mcp.mark-a-spot.com
PUBLIC_URL=https://mcp.mark-a-spot.com

# --- Tenant registry ---
# One entry per connected installation. Two apiUrl flavors:
#   - co-located on cp1: internal docker hostname (http://<tenant>-nginx-1:8080),
#     no public hairpin, citizen data never leaves the host
#   - self-hosted client: public HTTPS URL of their GeoReport endpoint
# defaultJurisdiction/defaultLang are optional per-tenant defaults so the model
# does not have to supply them for single-jurisdiction communes.
# Managed by mcp-add-tenant.sh; keep this a single line of valid JSON.
TENANTS_CONFIG=[{"id":"demo","name":"Mark-a-Spot Demo","apiUrl":"http://demo-nginx-1:8080","apiKey":"REPLACE_CITIZEN_KEY","staffApiKey":"REPLACE_STAFF_KEY","defaultJurisdiction":"1","defaultLang":"de"}]

# NOTE: the global JURISDICTIONS instructions list is intentionally UNSET on the
# gateway. It is a flat list and cannot represent per-tenant jurisdiction
# namespaces; use per-tenant defaultJurisdiction (above) and per-token
# allowedJurisdictions (below) instead.

# --- Auth: gate-everything, one pinned token per organization ---
# Every marketplace organization gets ONE Bearer token, generated by
# mcp-add-tenant.sh (openssl rand -hex 32). The token is pinned to its tenant
# ("tenant") and optionally to jurisdictions ("allowedJurisdictions"); the
# dispatch rejects any call targeting a foreign tenant with FORBIDDEN and
# overrides the tenant arg with the pin, so the tenant parameter is convenience,
# never authority.
#
# Marketplace assistants are municipal-internal, so tokens default to role:staff
# with read + intake + reporting. manage (update_request/add_comment) stays off:
# those tools key off request_id, cannot be confined by jurisdiction pinning,
# and belong on a single-tenant Enterprise bridge (see mcp.env.example).
# Managed by mcp-add-tenant.sh; keep this a single line of valid JSON.
MCP_AUTH_USERS=[{"mcpToken":"REPLACE_RANDOM_TOKEN_32B","name":"Ayunis Demo","tenant":"demo","role":"staff","allowedJurisdictions":["1"],"allowedToolsets":["read","intake","reporting"]}]

# --- Toolsets exposed by this deployment ---
# read       browse: list_services, list_requests, get_request, search_location
# intake     file reports + photo upload: create_request, prepare_upload,
#            upload_image, check_upload
# reporting  staff analytics KPIs: get_stats
# manage is deliberately NOT enabled on the shared gateway (see above).
ENABLED_TOOLSETS=read,intake,reporting

# --- Rate limit (Traefik, ONE bucket for the whole gateway router) ---
# All connected organizations share this budget; scale it with the customer
# count so one noisy tenant cannot starve the others. Token-keyed per-org
# limiting is the follow-up once volume justifies it (see GATEWAY.md).
MCP_RATELIMIT_AVG=240
MCP_RATELIMIT_BURST=80
MCP_RATELIMIT_PERIOD=1m

# --- Photo upload storage (local filesystem) ---
UPLOAD_STORAGE=fs
UPLOAD_DIR=/data/uploads
