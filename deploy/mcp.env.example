# GeoReport MCP Bridge - per-tenant env template for the cp1 stack-service model.
#
# Copy to /opt/markaspot-cloud/tenants/<tenant>.mcp.env on cp1 (chmod 600, never
# commit). One file per tenant bridge; the image is shared. The DEMO values below
# are the concrete first target (Ayunis demo at mcp.demo.mark-a-spot.com).

NODE_ENV=production
MCP_SERVER_PORT=3100
LOG_LEVEL=info

# --- Per-stack routing (consumed by docker-compose.mcp.yml, NOT by the app) ---
# Traefik Host rule + per-tenant namespacing for router/service/middleware names.
MCP_PROJECT=demo-mcp
MCP_PUBLIC_HOST=mcp.demo.mark-a-spot.com
PUBLIC_URL=https://mcp.demo.mark-a-spot.com

# --- Backend (Open311 / GeoReport v2), CO-LOCATED ---
# apiUrl points at the INTERNAL docker hostname of the demo nginx so citizen
# data never leaves the host (no public hairpin, lower latency, DSGVO).
# VERIFIED on cp1: settings.php trusted_host_patterns already contains
# '^.+-nginx-\d+$', so Host: demo-nginx-1 is accepted. Internal port is 8080.
# Smoke-test this at deploy time (see runbook) before trusting it.
#
# Preferred: TENANTS_CONFIG (multi-tenant JSON, also carries display name + keys).
TENANTS_CONFIG=[{"id":"demo","name":"Mark-a-Spot Demo","apiUrl":"http://demo-nginx-1:8080","apiKey":"REPLACE_CITIZEN_KEY","staffApiKey":"REPLACE_STAFF_KEY"}]
# Single-tenant fallback (only if TENANTS_CONFIG is unset):
# GEOREPORT_SERVER_URL=http://demo-nginx-1:8080
# GEOREPORT_API_KEY=REPLACE_CITIZEN_KEY

# Jurisdictions exposed to the chat (subset of the demo backend's jurisdictions).
# Demo backend currently serves: 1 Amsterdam, 4 Stadsdeel Noord, 5 Rotterdam,
# 7 Utrecht, 8 BCP Council, 9 Bournemouth, 10 Queens Park Ward.
JURISDICTIONS=[{"id":"1","name":"Amsterdam"},{"id":"8","name":"BCP Council"}]

# --- Auth: gate-everything model (no anonymous access) ---
# One scoped Bearer token for the Ayunis demo. Ayunis is a municipal-internal
# (verwaltungsinterner) assistant, so it is role:staff, NOT citizen. role:staff is
# required because reporting (get_stats) is a staff-only toolset; a citizen token
# with reporting in allowedToolsets would be rejected with FORBIDDEN by the
# dispatch. allowedToolsets grants read + intake + reporting; allowedJurisdictions
# pins the token so it cannot reach other cities even if it sends a foreign
# jurisdiction_id. mcpToken MUST be a real >=32-byte random secret supplied by
# Holger (placeholder below is intentionally invalid). Generate: openssl rand -hex 32
#
# NOTE: manage (update_request/add_comment) is deliberately NOT granted here.
# Those write tools key off request_id and carry no jurisdiction_id, so the
# dispatch cannot confine them to this token's allowed jurisdictions and BLOCKS
# manage for any jurisdiction-pinned token. To enable staff writes, configure a
# SEPARATE, non-jurisdiction-pinned staff token (no allowedJurisdictions) with a
# write-capable staffApiKey on the tenant, on a single-tenant Enterprise bridge.
#
# allowedToolsets accepts the canonical IDs below OR legacy persona aliases
# (citizen -> read+intake, staff -> all four).
MCP_AUTH_USERS=[{"mcpToken":"REPLACE_RANDOM_TOKEN_32B","name":"Ayunis Demo","tenant":"demo","role":"staff","allowedJurisdictions":["1","8"],"allowedToolsets":["read","intake","reporting"]}]

# --- Toolsets exposed by this deployment ---
# Toolsets are cut by FUNCTION, composed per consumer. read + intake are the
# baseline for any valid token; role:staff additionally unlocks manage +
# reporting.
#   read       browse: list_services, list_requests, get_request, search_location
#   intake     file reports + photo upload: create_request, prepare_upload,
#              upload_image, check_upload (citizen self-service AND staff on-behalf)
#   manage     staff write/admin: update_request, add_comment, list_tenants
#              - needs role:staff AND a non-jurisdiction-pinned token plus a
#                write-capable staffApiKey (pinning blocks request-id writes, so a
#                jurisdiction-pinned token cannot use manage)
#   reporting  staff analytics KPIs: get_stats - needs role:staff
#
# manage is left OUT of ENABLED_TOOLSETS below until a non-pinned staff token
# exists for it; reporting is enabled because the Ayunis staff token above uses it.
#
# Backward compatible: the legacy persona aliases still work and expand to the
# above (citizen=read,intake | staff=read,intake,manage,reporting), in both
# ENABLED_TOOLSETS and allowedToolsets.
ENABLED_TOOLSETS=read,intake,reporting

# --- Photo upload storage (local filesystem) ---
UPLOAD_STORAGE=fs
UPLOAD_DIR=/data/uploads
