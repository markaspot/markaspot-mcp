# pnpm config mirrored from the Mark-a-Spot frontend for DHI + pnpm 11 parity.
# Peer-dependency warnings are non-fatal for this server build.
auto-install-peers=false
strict-peer-dependencies=false

# Hoist nested deps so tsup/esbuild resolve transitive type packages reliably.
shamefully-hoist=true
public-hoist-pattern[]=*
