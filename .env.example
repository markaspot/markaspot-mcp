# GeoReport v2 API Configuration (single-tenant)
GEOREPORT_SERVER_URL=https://web
GEOREPORT_API_KEY=your_api_key_here
GEOREPORT_AUTH_METHOD=query

# Staff API Key (for update_request and add_comment tools)
# Needs a user with "access open311 advanced properties" permission
# GEOREPORT_STAFF_API_KEY=staff_key_here

# Legacy Mark-a-Spot compatibility (optional)
# MARKASPOT_API_URL=https://web
# MARKASPOT_API_TOKEN=your_api_token_here

# MCP Server Configuration
MCP_SERVER_PORT=3100
NODE_ENV=development
LOG_LEVEL=info

# Optional: MCP Authentication (for remote MCP clients)
# MCP_AUTH_TOKEN=your_mcp_auth_token_here

# Optional: Public URL for deployment
# PUBLIC_URL=https://mcp.your-domain.example

# Multi-Tenant Configuration (JSON array, overrides single-tenant vars above)
# TENANTS_CONFIG='[{"id":"demo","name":"Demo","apiUrl":"https://backend.demo.mark-a-spot.com","apiKey":"xxx","staffApiKey":"yyy"},{"id":"bonn","name":"Stadt Bonn","apiUrl":"https://management.bonn.example.com","apiKey":"zzz"}]'

# MCP Auth User Mapping (JSON array)
# Maps MCP Bearer tokens to staff API keys for per-user authorization
# MCP_AUTH_USERS='[{"mcpToken":"abc123","staffKey":"xyz789","name":"Sachbearbeiter Mueller"}]'
